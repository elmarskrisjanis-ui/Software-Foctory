# Local HTTPS entry point. "tls internal" uses Caddy's own local CA (development only).
# In a real deployment TLS is terminated by the hosting platform with a trusted certificate.
{
	auto_https disable_redirects
	admin off
}

https://localhost:8443 {
	tls internal
	encode zstd gzip
	reverse_proxy web:3000
	header -Server
}
