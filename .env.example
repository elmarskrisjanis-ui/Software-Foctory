# Local development only. Copy to .env (git-ignored) and replace the values with your own random strings.
# Never reuse real passwords here.
POSTGRES_PASSWORD=change-me-owner
COLLECTOR_DB_PASSWORD=change-me-collector
API_DB_PASSWORD=change-me-api

# Optional collector tuning (defaults shown)
# COLLECTOR_REFRESH_INTERVAL=12:00:00
# COLLECTOR_MAX_PAGES_PER_LISTING=10
# COLLECTOR_MAX_PRODUCT_PAGES=1500
