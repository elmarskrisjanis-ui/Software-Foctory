{
    "openapi": "3.1.1",
    "info": {
        "title": "BezProcentu API",
        "description": "Public, read-only API listing products from Riga online stores that currently offer interest-free (0%) financing. No authentication by design (see specification).",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://api:8080/"
        }
    ],
    "paths": {
        "/api/products": {
            "get": {
                "tags": [
                    "Public"
                ],
                "summary": "Products that currently have an interest-free (0%) offer.",
                "operationId": "SearchProducts",
                "parameters": [
                    {
                        "name": "Group",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Store",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Q",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "MinPrice",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "MaxPrice",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Sort",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Page",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "PageSize",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductPage"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products/{id}": {
            "get": {
                "tags": [
                    "Public"
                ],
                "summary": "One product with an active 0% offer.",
                "operationId": "GetProduct",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductDto"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/facets": {
            "get": {
                "tags": [
                    "Public"
                ],
                "summary": "Counts per group, category and store for the given filters.",
                "operationId": "GetFacets",
                "parameters": [
                    {
                        "name": "Group",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Store",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Q",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "MinPrice",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "MaxPrice",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Sort",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Page",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "PageSize",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Facets"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog": {
            "get": {
                "tags": [
                    "Public"
                ],
                "summary": "Product groups, categories and sort options.",
                "operationId": "GetCatalog",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/stores": {
            "get": {
                "tags": [
                    "Public"
                ],
                "summary": "Supported stores and the freshness of their data.",
                "operationId": "GetStores",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/StoreStatusDto"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CatalogResponse": {
                "required": [
                    "groups",
                    "categories",
                    "sortOptions"
                ],
                "type": "object",
                "properties": {
                    "groups": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryGroup"
                        }
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Category"
                        }
                    },
                    "sortOptions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "Category": {
                "required": [
                    "slug",
                    "name",
                    "groupSlug",
                    "sortOrder"
                ],
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "groupSlug": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "CategoryGroup": {
                "required": [
                    "slug",
                    "name",
                    "sortOrder"
                ],
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "FacetCount": {
                "required": [
                    "slug",
                    "name",
                    "group",
                    "count"
                ],
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "group": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "count": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "Facets": {
                "required": [
                    "groups",
                    "categories",
                    "stores",
                    "total"
                ],
                "type": "object",
                "properties": {
                    "groups": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetCount"
                        }
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetCount"
                        }
                    },
                    "stores": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetCount"
                        }
                    },
                    "total": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "ProductDto": {
                "required": [
                    "id",
                    "store",
                    "storeName",
                    "name",
                    "url",
                    "imageUrl",
                    "imageFallbackUrl",
                    "brand",
                    "category",
                    "categoryName",
                    "group",
                    "price",
                    "oldPrice",
                    "monthlyPayment",
                    "maxTermMonths",
                    "termsMonths",
                    "interestRatePercent",
                    "offerScope",
                    "provider",
                    "conditions",
                    "offerSourceUrl",
                    "verifiedAt"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "store": {
                        "type": "string"
                    },
                    "storeName": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "imageUrl": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "imageFallbackUrl": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "brand": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "category": {
                        "type": "string"
                    },
                    "categoryName": {
                        "type": "string"
                    },
                    "group": {
                        "type": "string"
                    },
                    "price": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "oldPrice": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "null",
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "monthlyPayment": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "maxTermMonths": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "termsMonths": {
                        "type": "array",
                        "items": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    "interestRatePercent": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "offerScope": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "conditions": {
                        "type": "string"
                    },
                    "offerSourceUrl": {
                        "type": "string"
                    },
                    "verifiedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ProductPage": {
                "required": [
                    "items",
                    "total",
                    "page",
                    "pageSize"
                ],
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductDto"
                        }
                    },
                    "total": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "page": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "pageSize": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "StoreStatusDto": {
                "required": [
                    "slug",
                    "name",
                    "homepageUrl",
                    "status",
                    "note",
                    "lastSuccessfulRunAt",
                    "lastRunStatus",
                    "lastRunAt",
                    "interestFreeProgrammeActive",
                    "activeOffers"
                ],
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "homepageUrl": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "note": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "lastSuccessfulRunAt": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "format": "date-time"
                    },
                    "lastRunStatus": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "lastRunAt": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "format": "date-time"
                    },
                    "interestFreeProgrammeActive": {
                        "type": [
                            "null",
                            "boolean"
                        ]
                    },
                    "activeOffers": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Public"
        }
    ]
}
